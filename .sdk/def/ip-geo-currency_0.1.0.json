{
  "openapi": "3.0.3",
  "info": {
    "title": "IP Geo Currency API",
    "description": "This API provides geolocation information and currency data based on a user's IP address. It allows developers to retrieve IP details such as country, city, and currency exchange rates through simple HTTP requests.",
    "version": "1.0.0",
    "contact": {
      "url": "https://apip.cc/docs.html"
    },
    "termsOfService": "https://apip.cc/terms"
  },
  "servers": [
    {
      "url": "https://apip.cc",
      "description": "Production server"
    }
  ],
  "paths": {
    "/json": {
      "get": {
        "summary": "Get your IP info",
        "description": "Retrieves geolocation and currency information for the requesting IP address",
        "operationId": "getOwnIpInfo",
        "parameters": [
          {
            "name": "nolog",
            "in": "query",
            "description": "Disable logging feature when set (no value required)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with IP geolocation data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpGeoResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (10 requests per second)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api-json/{ip-or-domain}": {
      "get": {
        "summary": "Get any IP info",
        "description": "Retrieves geolocation and currency information for a specific IP address or domain",
        "operationId": "getIpInfo",
        "parameters": [
          {
            "name": "ip-or-domain",
            "in": "path",
            "description": "IP address (e.g., 8.8.8.8) or domain name to look up",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "8.8.8.8"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with IP geolocation data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpGeoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid IP address or domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (10 requests per second)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rates.json": {
      "get": {
        "summary": "Get currency rates",
        "description": "Retrieves all currency exchange rates based on USD",
        "operationId": "getCurrencyRates",
        "responses": {
          "200": {
            "description": "Successful response with currency rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrencyRatesResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (10 requests per second)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
