  "components": {
    "schemas": {
      "IpGeoResponse": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "description": "IP address",
            "example": "8.8.8.8"
          },
          "country": {
            "type": "string",
            "description": "Country name",
            "example": "United States"
          },
          "country_code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "example": "US"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "Mountain View"
          },
          "continent": {
            "type": "string",
            "description": "Continent name",
            "example": "North America"
          },
          "continent_code": {
            "type": "string",
            "description": "Continent code",
            "example": "NA"
          },
          "region": {
            "type": "string",
            "description": "Region or state",
            "example": "California"
          },
          "latitude": {
            "type": "number",
            "description": "Latitude coordinate",
            "example": 37.386
          },
          "longitude": {
            "type": "number",
            "description": "Longitude coordinate",
            "example": -122.0838
          },
          "timezone": {
            "type": "string",
            "description": "Timezone",
            "example": "America/Los_Angeles"
          },
          "currency": {
            "type": "string",
            "description": "Currency code",
            "example": "USD"
          },
          "currency_name": {
            "type": "string",
            "description": "Currency name",
            "example": "United States Dollar"
          }
        }
      },
      "CurrencyRatesResponse": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "description": "Base currency (USD)",
            "example": "USD"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the rates",
            "example": "2024-01-15"
          },
          "rates": {
            "type": "object",
            "description": "Exchange rates for all supported currencies",
            "additionalProperties": {
              "type": "number"
            },
            "example": {
              "EUR": 0.92,
              "GBP": 0.79,
              "JPY": 149.5,
              "AUD": 1.52
            }
          }
        }
      },
      "CurrencyConversionResponse": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Original amount",
            "example": 10
          },
          "base": {
            "type": "string",
            "description": "Source currency code",
            "example": "GBP"
          },
          "target": {
            "type": "string",
            "description": "Target currency code",
            "example": "USD"
          },
          "result": {
            "type": "number",
            "description": "Converted amount",
            "example": 12.65
          },
          "rate": {
            "type": "number",
            "description": "Exchange rate used",
            "example": 1.265
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          }
        }
      }
    }
  },
  "x-rate-limit": {
    "description": "This API is limited to 10 requests per second from an IP address. Custom domains can increase this to 20 requests per second."
  }
}
