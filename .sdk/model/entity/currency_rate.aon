# Entity: currency_rate

main: kit: entity: currency_rate: {

  alias: field: {}

  name: "currency_rate"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/rates.json"
          parts: [
            "rates.json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.rates`"
          }
        }
      ]
    }
  }



}
