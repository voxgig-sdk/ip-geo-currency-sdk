# Entity: api_json

main: kit: entity: api_json: {

  alias: field: {}

  fields: [
    {
      name: "city"
      req: false
      type: "`$STRING`"
    }
    {
      name: "continent"
      req: false
      type: "`$STRING`"
    }
    {
      name: "continent_code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      type: "`$STRING`"
    }
    {
      name: "country_code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "currency"
      req: false
      type: "`$STRING`"
    }
    {
      name: "currency_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ip"
      req: false
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "region"
      req: false
      type: "`$STRING`"
    }
    {
      name: "timezone"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "api_json"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "8.8.8.8"
                kind: "param"
                name: "id"
                orig: "ip_or_domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api-json/{ip-or-domain}"
          parts: [
            "api-json"
            "{id}"
          ]
          rename: {
            param: {
              "ip-or-domain": "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
