# Entity: currency_rate

main: kit: entity: currency_rate: {

  alias: field: {}

  fields: {
    base: {
      h: "Base"
      n: "base"
      r: false
      sh: "Base currency (USD)"
      t: "`$STRING`"
    }
    date: {
      fo: "date"
      h: "Date"
      n: "date"
      r: false
      sh: "Date of the rates"
      t: "`$STRING`"
    }
    rates: {
      h: "Rates"
      n: "rates"
      r: false
      sh: "Exchange rates for all supported currencies"
      t: "`$OBJECT`"
    }
  }

  name: "currency_rate"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /rates.json"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/rates.json"
          s: [
            {
              lit: "rates.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
