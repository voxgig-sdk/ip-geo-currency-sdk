  name: "currency_conversion"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 10
                kind: "param"
                name: "amount"
                orig: "amount"
                reqd: true
                type: "`$NUMBER`"
              }
